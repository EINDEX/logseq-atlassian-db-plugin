{
  "name": "logseq-atlassian-linker",
  "version": "0.1.0",
  "description": "Logseq DB graph plugin that rewrites Atlassian URLs to Markdown links and stores Jira/Confluence metadata as DB properties.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.html",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@logseq/libs": "^0.3.3"
  },
  "overrides": {
    "dompurify": "^3.4.2",
    "lodash-es": "^4.18.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  },
  "logseq": {
    "id": "logseq-atlassian-linker",
    "title": "Atlassian Linker",
    "main": "dist/index.html",
    "effect": true,
    "supportsDB": true,
    "supportsDBOnly": true
  }
}
